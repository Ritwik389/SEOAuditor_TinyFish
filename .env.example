# Sniffsite environment. Copy to .env.local (development) or set these in your host (production).
# Placeholders only. Never commit real values.
#
# NOTE: TinyFish and Gemini keys are NOT set here. Every user adds their own on the Setup page after
# creating an account; they are stored encrypted and used only for that user's audits.

# --- Database (set by the operator ONLY; never entered on the website) -------------------------------
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sniffsite

# --- Encryption of users' saved API keys (REQUIRED for the Setup page to save keys) -------------------
# 32 random bytes, base64. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this OUT of the database. Losing it makes saved keys unreadable (users re-enter them).
CREDENTIAL_ENCRYPTION_KEY=

# --- Sessions -----------------------------------------------------------------------------------------
# Secret used to sign session cookies. Optional: defaults to a value derived from CREDENTIAL_ENCRYPTION_KEY.
SESSION_SECRET=
# Set to false to stop new accounts being created (existing users can still sign in).
SIGNUPS_ENABLED=true

# --- Optional ----------------------------------------------------------------------------------------
# Default Gemini model for accounts that have not chosen one on the Setup page.
GEMINI_MODEL=gemini-3.8-flash
APP_URL=http://localhost:3000

# --- Only for `npm run smoke:live` (a developer check; the app itself never reads these) ----------------
# TINYFISH_API_KEY=
# GEMINI_API_KEY=

# --- Testing only (never set in production; inert or ignored there) -------------------------------------
# SNIFFSITE_STORE=memory                 # in-memory, non-durable store
# SNIFFSITE_ALLOW_PRIVATE_TARGETS=1      # lets audits target local mock servers
# TINYFISH_SEARCH_URL=http://127.0.0.1:4010/search
# TINYFISH_FETCH_URL=http://127.0.0.1:4010/fetch
# TINYFISH_BROWSER_URL=http://127.0.0.1:4010/browser
# GEMINI_BASE_URL=http://127.0.0.1:4010/gemini
# SNIFFSITE_RATE_LIMIT_MULTIPLIER=10
